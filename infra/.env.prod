# Copie este arquivo para infra/.env.prod e preencha com valores reais.

# Neon/Postgres em nuvem.
# Exemplo Neon:
# DATABASE_URL=jdbc:postgresql://ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://ep-divine-recipe-ac0nz7gg-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=npg_PaoqJFvRfd02

# Frontend publico que podera chamar a API.
# Em teste local com compose prod, mantenha localhost.
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173

# URL que o frontend buildado usa para chamar a API.
# Em deploy real, troque para a URL publica do backend.
VITE_API_URL=http://localhost:8080/api

# Portas locais expostas pelo compose de producao/staging.
BACKEND_PORT=8080
FRONTEND_PORT=4173

# Use um segredo longo e unico em producao.
JWT_SECRET=segredo-jwt-muito-seguro-da-vmais
JWT_EXPIRATION_MINUTES=480

# Primeiro admin criado automaticamente se o banco estiver vazio.
VMAIS_ADMIN_EMAIL=virginio.dev@gmail.com
VMAIS_ADMIN_PASSWORD=3umateuz
VMAIS_ADMIN_NAME=Desenvolvedor
