{
  "name": "vmais-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "preview:frontend": "npm --prefix frontend run preview",
    "dev:backend": "cd backend && ./mvnw spring-boot:run",
    "build:backend": "cd backend && ./mvnw package",
    "dev:stack": "docker compose -f infra/docker-compose.yml up --build",
    "stop:stack": "docker compose -f infra/docker-compose.yml down",
    "prod:stack": "docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml pull && docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml up -d",
    "prod:logs": "docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml logs -f",
    "stop:prod": "docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml down",
    "bot:dry-run": "python3 bot/dry_run.py",
    "bot:dry-run:all": "python3 bot/dry_run.py --force",
    "bot:install": "npm --prefix bot install",
    "bot:groups": "npm --prefix bot run groups",
    "bot:worker": "npm --prefix bot run worker",
    "bot:worker:send": "npm --prefix bot run worker:send",
    "bot:worker:loop": "npm --prefix bot run worker:loop",
    "dev": "npm run dev:frontend"
  }
}
