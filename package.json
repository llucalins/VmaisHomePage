{
  "name": "vmais-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "preview:frontend": "npm --prefix frontend run preview",
    "dev:backend": "cd backend && ./mvnw spring-boot:run",
    "build:backend": "cd backend && ./mvnw package",
    "dev:stack": "docker compose -f infra/docker-compose.yml up --build",
    "stop:stack": "docker compose -f infra/docker-compose.yml down",
    "dev": "npm run dev:frontend"
  }
}
