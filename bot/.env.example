VMAIS_API_URL=http://localhost:8080/api
VMAIS_ADMIN_EMAIL=admin@vmais.local
VMAIS_ADMIN_PASSWORD=admin123
VMAIS_WHATSAPP_GROUP_NAME=Nome exato do grupo

# Janela de tolerancia para considerar um disparo pendente.
# Exemplo: se o bot rodar a cada 5 minutos, deixe 5 ou 10.
VMAIS_BOT_LOOKAHEAD_MINUTES=0
VMAIS_BOT_LOOKBACK_MINUTES=60
VMAIS_BOT_DAYS=7
VMAIS_BOT_INTERVAL_SECONDS=300

# Pasta local onde o Baileys guarda a sessao do WhatsApp Web.
# Nao versionar essa pasta.
VMAIS_BAILEYS_AUTH_DIR=auth
